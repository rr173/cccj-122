                        xlink:role="http://example.com/role/bad-self-loop">
    <link:loc xlink:type="locator" xlink:href="#cycle_a" xlink:label="a"/>
    <link:calculationArc xlink:type="arc" xlink:from="a" xlink:to="a"
                         xlink:arcrole="http://www.xbrl.org/2003/arcrole/summation-item"
                         weight="1"/>
  </link:calculationLink>
</link:linkbase>
